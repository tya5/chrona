        "actual": {
          "color": "#269D79",
          "opacity": 1
        },
        "baseline": {
          "color": "#637187",
          "opacity": 1
        },
        "variance": {
          "color": "#C8762B",
          "opacity": 1
        }
      },
      "groups": {
        "delivery": {
          "actual": {
            "color": "#176F59",
            "opacity": 1
          }
        }
      }
    },
    "annotation": {
      "boxFill": {
        "color": "#FFFFFF",
        "opacity": 1
