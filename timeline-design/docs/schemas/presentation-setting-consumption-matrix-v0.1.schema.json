{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chrona/presentation-setting-consumption-matrix/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evaluatedAt", "rows"],
  "properties": {
    "version": {"const": "chrona/presentation-setting-consumption-matrix/v0.1"},
    "evaluatedAt": {"type": "string", "minLength": 7},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "settingPattern", "owner", "classification", "trigger", "observer", "disposition"],
        "properties": {
          "id": {"type": "string", "pattern": "^SC-[0-9]{2}$"},
          "settingPattern": {"type": "string", "minLength": 3},
          "owner": {"enum": ["Theme", "Layout", "Detail", "Context", "Output"]},
          "classification": {"enum": ["unconditional", "conditional", "validation-only", "superseded"]},
          "trigger": {"type": "string", "minLength": 1},
          "observer": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["implemented", "remediation-required", "validation-only", "superseded"]},
          "issue": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    }
  }
}
